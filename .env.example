PORT=3003
HOST=0.0.0.0
MAX_FILE_SIZE_MB=10
# Threshold per kategori. Porn/Hentai ketat, Sexy longgar karena paling noisy.
NSFW_THRESHOLD_PORN=0.3
NSFW_THRESHOLD_HENTAI=0.3
NSFW_THRESHOLD_SEXY=0.8
# Fallback untuk kategori yang tidak diset di atas.
# Biarkan tetap komentar agar default per kategori dipakai.
# NSFW_THRESHOLD=0.5
# Recommended for production: point this at a pre-downloaded model directory.
# Leave empty to let NSFWJS load its default hosted model.
NSFW_MODEL_PATH=
# Optional comma-separated allowed MIME types.
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
